        additionalArgs?: [{
            // name of the argument, e.g. "scrape.discovery-reload-interval".
            name: string
            // value defines the argument value, e.g. 30s. Can be empty for name-only arguments (e.g.
            // --storage.tsdb.no-lockfile)
            value?: string
