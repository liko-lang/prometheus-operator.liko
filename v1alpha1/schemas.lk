            group: "monitoring.coreos.com"
            // name defines the name of the referenced object.
            name: string
            // namespace defines the namespace of the referenced object.
            namespace: string
            // resource defines the type of resource being referenced (e.g. Prometheus,
            // PrometheusAgent, ThanosRuler or Alertmanager).
            resource: "prometheuses" or "prometheusagents" or "thanosrulers" or "alertmanagers"
        }]
    }
}

// The `PrometheusAgent` custom resource definition (CRD) defines a desired [Prometheus
// Agent](https://prometheus.io/blog/2021/11/16/agent/) setup to run in a Kubernetes cluster.
//
// The CRD is very similar to the `Prometheus` CRD except for features which aren't available in agent
